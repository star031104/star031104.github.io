{
  "name": "blog-ai-assistant-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "deploy": "wrangler deploy --env=\"\" --minify",
    "deploy:staging": "wrangler deploy --env staging --minify",
    "deploy:dry": "wrangler deploy --env=\"\" --dry-run --outdir .wrangler/dry-run",
    "test": "vitest run",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
